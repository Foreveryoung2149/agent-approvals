# Database (PostgreSQL — required for real accounts, webhooks, approvals)
DATABASE_URL=postgresql://user:password@localhost:5432/agent_approvals

# API server
PORT=3002
# Set to api on the API service; omit or set web on the Next.js service
SERVICE_ROLE=api
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1

# Dev API key (bypasses database for local development)
DEV_API_KEY=appr_dev_devkey
API_AUTH_DISABLED=false

# App URL (used in approval email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002

# Authentication (generate independent random values; required in production)
SESSION_SECRET=
# Independent server-side pepper for short-lived email verification/reset codes
AUTH_CODE_PEPPER=
# 32 random bytes encoded as 64 hexadecimal characters or base64url
TOTP_ENCRYPTION_KEY=

# Resend (email delivery for approval requests)
RESEND_API_KEY=
FROM_EMAIL=approvals@agentapprovals.dev

# Stripe (billing — set up later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
