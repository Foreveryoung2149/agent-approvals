{
  "name": "@nodsend/openclaw",
  "version": "0.1.0-experimental.1",
  "description": "Experimental Nodsend approval gate for OpenClaw tool calls",
  "type": "module",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Foreveryoung2149/Nodsend.git",
    "directory": "integrations/openclaw"
  },
  "homepage": "https://nodsend.com/docs",
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "runtimeExtensions": ["./dist/index.js"]
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": { "optional": true }
  },
  "dependencies": {
    "@nodsend/sdk": "file:../../sdks/typescript"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
